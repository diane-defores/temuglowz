{
  "name": "@temuglowz/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first Temu shopping list app built with Vue, Tauri, and Convex.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "vite -c vite.tauri.config.ts",
    "tauri:build": "vite build -c vite.tauri.config.ts",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:android:init": "tauri android init",
    "test": "vitest",
    "test:once": "vitest run",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:convex && pnpm typecheck:full",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.typecheck.core.json",
    "typecheck:full": "vue-tsc --noEmit -p tsconfig.json",
    "convex:codegen": "convex codegen --typecheck disable",
    "lint": "eslint .",
    "lint:check": "eslint . --quiet",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.92",
    "@tauri-apps/api": "^2.3.0",
    "convex": "^1.41.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "4.2.0",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.0"
  }
}
