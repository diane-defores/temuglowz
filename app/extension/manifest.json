{
  "manifest_version": 3,
  "name": "Temu Shopping Lists",
  "description": "Extension pour ajouter des produits Temu à vos listes de shopping",
  "version": "1.0.0",
  "icons": {
    "16": "/icons/icon16.png",
    "32": "/icons/icon32.png",
    "48": "/icons/icon48.png",
    "128": "/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.temu.com/*", "*://temu.com/*"],
      "js": ["/content/overlay.js"],
      "css": ["/content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "/popup/popup.html",
    "default_title": "Ouvrir les listes de shopping"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.temu.com/*", "*://temu.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["/icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}