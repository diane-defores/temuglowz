{
  "name": "temuglowz",
  "private": true,
  "version": "0.1.0",
  "description": "TemuGlowz monorepo orchestrator for the app and public site.",
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "packageManager": "pnpm@8.11.0",
  "scripts": {
    "dev:app": "pnpm --filter @temuglowz/app dev",
    "dev:site": "pnpm --filter @temuglowz/site dev",
    "build": "pnpm -r build",
    "build:app": "pnpm --filter @temuglowz/app build",
    "build:site": "pnpm --filter @temuglowz/site build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test:once",
    "lint": "pnpm -r --if-present lint:check",
    "tauri": "pnpm --filter @temuglowz/app tauri",
    "tauri:dev": "pnpm --filter @temuglowz/app tauri:dev",
    "tauri:build": "pnpm --filter @temuglowz/app tauri:build",
    "tauri:android:init": "pnpm --filter @temuglowz/app tauri:android:init",
    "tauri:android:dev": "pnpm --filter @temuglowz/app tauri:android:dev",
    "tauri:android:build": "pnpm --filter @temuglowz/app tauri:android:build",
    "convex:codegen": "pnpm --filter @temuglowz/app convex:codegen"
  }
}
