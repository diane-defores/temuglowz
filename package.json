{
  "name": "temu-shopping-lists",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first Temu shopping list archive built with Vue + Vite + Tauri.",
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "packageManager": "pnpm@8.11.0",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "pnpm exec tauri",
    "tauri:dev": "vite -c vite.tauri.config.ts",
    "tauri:build": "vite build -c vite.tauri.config.ts",
    "tauri:android:dev": "pnpm exec tauri android dev",
    "tauri:android:build": "pnpm exec tauri android build",
    "tauri:android:init": "pnpm exec tauri android init",
    "test": "vitest",
    "test:once": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.core.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.typecheck.core.json",
    "typecheck:full": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:check": "eslint . --quiet",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.3.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "4.2.0",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^12.8.2",
    "@eslint/js": "^9.35.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.0.0",
    "vite-plugin-vue-devtools": "^7.4.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.0",
    "@tauri-apps/cli": "^2.8.4"
  }
}
