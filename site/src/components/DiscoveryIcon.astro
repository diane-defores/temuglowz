  {name === 'sparkles' && <><path d="m12 3 1.35 4.15L17.5 8.5l-4.15 1.35L12 14l-1.35-4.15L6.5 8.5l4.15-1.35L12 3Z"/><path d="m18.5 14 .75 2.25L21.5 17l-2.25.75L18.5 20l-.75-2.25L15.5 17l2.25-.75.75-2.25Z"/><path d="M5 14.5 5.5 16l1.5.5-1.5.5L5 18.5 4.5 17 3 16.5l1.5-.5.5-1.5Z"/></>}
  {name === 'kitchen' && <><path d="M7 3v8"/><path d="M4.5 3v5a2.5 2.5 0 0 0 5 0V3"/><path d="M7 11v10"/><path d="M16 3c-2 2.2-3 4.7-3 7.5 0 2 1.2 3.5 3 3.5V3Z"/><path d="M16 14v7"/></>}
  {name === 'cooling' && <><path d="M12 2v20M4.2 6.5l15.6 11M19.8 6.5l-15.6 11"/><path d="m9.5 4 2.5 2 2.5-2M9.5 20l2.5-2 2.5 2M5 9l3 .4.5-3M19 15l-3-.4-.5 3M19 9l-3 .4-.5-3M5 15l3-.4.5 3"/></>}
  {name === 'gift' && <><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 12h18"/><path d="M12 8H8.5a2.5 2.5 0 1 1 2.2-3.7L12 8Zm0 0h3.5a2.5 2.5 0 1 0-2.2-3.7L12 8Z"/></>}
  {name === 'outdoors' && <><path d="M8 21v-8a4 4 0 0 1 8 0v8"/><path d="M6 21h12M9 6V3h6v3"/><path d="M8.5 7h7A3.5 3.5 0 0 1 19 10.5V18h-3M8 18H5v-7.5A3.5 3.5 0 0 1 8.5 7Z"/><path d="M5 13h3M16 13h3"/></>}
  {name === 'toolbox' && <><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2"/></>}
  {name === 'wind' && <><path d="M4 8h9a2 2 0 1 0-2-2M4 12h14a2 2 0 1 1-2 2M4 16h7"/></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/><path d="M11 8v6M8 11h6"/></>}
</svg>
