---
import DiscoveryIcon from './DiscoveryIcon.astro'

const themes = [
  {
    icon: 'kitchen' as const,
    title: 'Cuisine futée',
    description: 'Des ustensiles et accessoires tout simples pour cuisiner, ranger et nettoyer plus facilement.',
    href: '/guides/kitchen-gadgets',
    status: 'À découvrir maintenant',
  },
  {
    icon: 'cooling' as const,
    title: 'Été au frais',
    description: 'Ventilos de poche, accessoires frais et petites astuces pour mieux supporter les journées chaudes.',
    href: '/guides/summer-cooling',
    status: 'À découvrir maintenant',
  },
  {
    icon: 'gift' as const,
    title: 'Cadeaux inattendus',
    description: 'Des idées mignonnes, drôles ou inattendues pour faire plaisir sans offrir toujours la même chose.',
    status: 'Bientôt par ici',
  },
  {
    icon: 'outdoors' as const,
    title: 'Escapades pratiques',
    description: 'Des objets compacts et pratiques à glisser dans la voiture, la tente ou le sac du week-end.',
    status: 'Bientôt par ici',
  },
]
---

<section id="themes" class="scroll-mt-28 bg-card px-4 py-16 sm:py-24" aria-labelledby="themes-title">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-wider text-muted-foreground">À chacun sa petite obsession</p>
      <h2 id="themes-title" class="mt-3 font-instrument-sans text-3xl font-bold text-foreground sm:text-5xl">Vous cherchez quoi aujourd’hui&nbsp;?</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">Un coup de pouce en cuisine, un peu d’air frais ou une idée cadeau qui change&nbsp;? Piochez selon votre envie.</p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {themes.map((theme) => (
        theme.href ? (
          <a href={theme.href} class="group flex h-full flex-col rounded-3xl border border-border bg-background p-5 transition-colors hover:border-foreground/30 hover:bg-muted/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground">
            <div class="flex items-start gap-3">
              <div class="flex-1">
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">{theme.status}</p>
                <h3 class="mt-1.5 text-lg font-semibold text-foreground group-hover:text-foreground">{theme.title}</h3>
              </div>
              <DiscoveryIcon name={theme.icon} class="h-7 w-7 flex-shrink-0 text-muted-foreground" />
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{theme.description}</p>
            <span class="mt-auto pt-4 inline-flex items-center justify-end gap-2 text-sm font-medium text-foreground">Voir les idées <span aria-hidden="true">→</span></span>
          </a>
        ) : (
          <article class="flex h-full flex-col rounded-3xl border border-dashed border-border bg-background/50 p-5">
            <div class="flex items-start gap-3">
              <div class="flex-1">
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">{theme.status}</p>
                <h3 class="mt-1.5 text-lg font-semibold text-foreground">{theme.title}</h3>
              </div>
              <DiscoveryIcon name={theme.icon} class="h-7 w-7 flex-shrink-0 text-muted-foreground" />
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{theme.description}</p>
            <span class="mt-auto pt-4 inline-flex items-center justify-end rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">Ça arrive bientôt</span>
          </article>
        )
      ))}
    </div>
  </div>
</section>
