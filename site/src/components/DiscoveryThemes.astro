---
import DiscoveryIcon from './DiscoveryIcon.astro'

const themes = [
  {
    icon: 'kitchen' as const,
    title: 'Cuisine futée',
    description: 'Ustensiles, rangement et accessoires à comparer pour gagner en confort au quotidien.',
    href: '/guides/kitchen-gadgets',
    status: 'Guide publié',
  },
  {
    icon: 'cooling' as const,
    title: 'Été au frais',
    description: 'Ventilation, fraîcheur nomade et petits formats pour mieux traverser les journées chaudes.',
    href: '/guides/summer-cooling',
    status: 'Guide publié',
  },
  {
    icon: 'gift' as const,
    title: 'Cadeaux inattendus',
    description: 'Des pistes mignonnes ou insolites à explorer pour une future sélection complète.',
    status: 'Thème en préparation',
  },
  {
    icon: 'outdoors' as const,
    title: 'Escapades pratiques',
    description: 'Des idées compactes pour le camping, la voiture et les week-ends — sans faux rayon à moitié vide.',
    status: 'Thème en préparation',
  },
]
---

<section id="themes" class="scroll-mt-28 bg-card px-4 py-16 sm:py-24" aria-labelledby="themes-title">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-wider text-muted-foreground">La caverne, bien rangée</p>
      <h2 id="themes-title" class="mt-3 font-instrument-sans text-3xl font-bold text-foreground sm:text-5xl">Choisissez une envie, pas un tunnel de vente.</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">Deux univers sont déjà prêts à explorer. Les prochains restent clairement indiqués comme des idées en préparation.</p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {themes.map((theme) => (
        theme.href ? (
          <a href={theme.href} class="group rounded-3xl border border-border bg-background p-6 transition-colors hover:border-foreground/30 hover:bg-muted/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground">
            <DiscoveryIcon name={theme.icon} />
            <p class="mt-6 text-xs font-medium uppercase tracking-wider text-muted-foreground">{theme.status}</p>
            <h3 class="mt-2 text-xl font-semibold text-foreground group-hover:text-foreground">{theme.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{theme.description}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-foreground">Ouvrir le guide <span aria-hidden="true">→</span></span>
          </a>
        ) : (
          <article class="rounded-3xl border border-dashed border-border bg-background/50 p-6">
            <DiscoveryIcon name={theme.icon} />
            <p class="mt-6 text-xs font-medium uppercase tracking-wider text-muted-foreground">{theme.status}</p>
            <h3 class="mt-2 text-xl font-semibold text-foreground">{theme.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{theme.description}</p>
            <span class="mt-6 inline-flex rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">Pas encore de lien</span>
          </article>
        )
      ))}
    </div>
  </div>
</section>
