<section id="features" class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-8 sm:px-10">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <p class="animate-fade-up text-sm font-medium text-muted-foreground uppercase tracking-wider mb-2">Fonctionnalités</p>
      <h2 class="animate-fade-up delay-100 text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">
        Tout ce qu’il vous faut, rien de superflu
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal>
      <!-- Local Archive (large card) -->
      <div class="md:col-span-2 animate-fade-up group relative flex flex-col justify-between rounded-2xl bg-card border border-border p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg overflow-hidden">
        <div>
          <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Archive locale</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Vos paniers, commandes et fiches produit Temu restent sur votre appareil. Pas de dépendance au cloud, pas de connexion obligatoire, pas de données hors de votre contrôle.
          </p>
        </div>
        <div class="mt-6 flex items-center justify-between gap-4">
          <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Vos données, votre appareil</span>
          <div class="hidden sm:flex items-center gap-1 text-primary/70">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="m12 3 1.35 4.15L17.5 8.5l-4.15 1.35L12 14l-1.35-4.15L6.5 8.5l4.15-1.35L12 3Z"/><path d="m18.5 14 .75 2.25L21.5 17l-2.25.75L18.5 20l-.75-2.25L15.5 17l2.25-.75.75-2.25Z"/></svg>
          </div>
        </div>
      </div>

      <!-- Price Tracking -->
      <div class="animate-fade-up delay-100 group relative flex flex-col justify-between rounded-2xl bg-card border border-border p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg">
        <div>
          <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Historique des prix</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Suivez les variations de prix. Sachez quand une offre est réelle et quand il ne s’agit que de bruit.
          </p>
        </div>
        <div class="mt-6 flex items-center justify-between">
          <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Voir la tendance</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-primary/70 group-hover:scale-110 transition-transform duration-300"><path d="m3 17 6-6 4 4 8-8"/><path d="M17 7h4v4"/></svg>
        </div>
      </div>

      <!-- Product Context -->
      <div class="animate-fade-up delay-200 group relative flex flex-col justify-between rounded-2xl bg-card border border-border p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg">
        <div>
          <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Contexte produit</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Gardez le titre, l’image, les notes, les options, la disponibilité et l’historique des observations au même endroit.
          </p>
        </div>
        <div class="mt-6 flex items-center justify-between">
          <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Vue complète du produit</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-primary/70 group-hover:scale-110 transition-transform duration-300"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
        </div>
      </div>

      <!-- Multi-Device -->
      <div class="animate-fade-up delay-300 group relative flex flex-col justify-between rounded-2xl bg-card border border-border p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg">
        <div>
          <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Ordinateur + Android</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Retrouvez votre méthode d’achat sur ordinateur et Android grâce à une base de code commune.
          </p>
        </div>
        <div class="mt-6 flex items-center justify-between">
          <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Prêt pour plusieurs appareils</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-primary/70 group-hover:scale-110 transition-transform duration-300"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
        </div>
      </div>

      <!-- Privacy First -->
      <div class="animate-fade-up delay-400 group relative flex flex-col justify-between rounded-2xl bg-card border border-border p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg">
        <div>
          <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Confidentialité d’abord</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Pas de cookies, pas d’extraction de session, pas de stockage d’identifiants. Vous êtes la seule personne à accéder à vos données.
          </p>
          <div class="flex flex-wrap items-center gap-2 mt-4">
            <span class="px-2 py-1 text-xs bg-muted rounded text-muted-foreground">Local</span>
            <span class="px-2 py-1 text-xs bg-muted rounded text-muted-foreground">Sans cloud</span>
            <span class="px-2 py-1 text-xs bg-muted rounded text-muted-foreground">Sync facultative</span>
          </div>
        </div>
        <div class="mt-6 flex items-center justify-between">
          <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Préserver votre confidentialité</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-primary/70 group-hover:scale-110 transition-transform duration-300"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
      </div>
    </div>
  </div>
</section>
