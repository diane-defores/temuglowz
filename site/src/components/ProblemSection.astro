---
const problems = [
  {
    icon: '🛒',
    title: 'Paniers dispersés',
    description: 'Les paniers et commandes Temu se retrouvent dans les e-mails, les onglets du navigateur et les captures d’écran. Retrouver un article ou un prix devient vite une chasse au trésor.',
    wide: true,
  },
  {
    icon: '📦',
    title: 'Commandes multiples',
    description: 'Les achats groupés impliquent souvent plusieurs commandes à la fois. Sans archive locale, il devient difficile de savoir ce qui est arrivé, ce qui est en attente et ce qu’il faut recommander.',
  },
  {
    icon: '📈',
    title: 'Prix changeants',
    description: 'Les prix évoluent entre le panier et le paiement, ou d’une offre à l’autre. Sans historique, impossible de savoir si une promotion est réellement intéressante.',
  },
  {
    icon: '🗂️',
    title: 'Informations éparpillées',
    description: 'Confirmations de commande, liens de suivi et listes de souhaits vivent à part de l’endroit où vous gérez réellement vos achats Temu.',
  },
]
---

<section class="py-16 sm:py-24 bg-card">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <h2
        class="animate-fade-up text-3xl sm:text-4xl font-bold text-foreground mb-4"
        style="font-family: var(--font-instrument-sans);"
      >
        Vos achats Temu sont répartis sur trop de supports
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-reveal>
      {problems.map((problem, index) => (
        <div
          class={`animate-fade-up delay-${(index + 1) * 100} group relative p-6 rounded-2xl bg-background border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300 ${
            problem.wide ? 'md:col-span-2' : ''
          }`}
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="text-3xl sm:text-4xl">{problem.icon}</span>
            <h3 class="text-xl sm:text-2xl font-semibold text-foreground">{problem.title}</h3>
          </div>
          <p class="text-base text-muted-foreground leading-relaxed">{problem.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
