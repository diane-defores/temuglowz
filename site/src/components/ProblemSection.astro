---
const problems = [
  {
    icon: '🛒',
    title: 'Cart Chaos',
    description: 'Temu carts and orders get scattered across emails, browser tabs, and screenshots. Finding a specific item or price becomes a hunt.',
    wide: true,
  },
  {
    icon: '📦',
    title: 'Multiple Orders',
    description: 'Batch buyers juggle several orders at once. Without a local archive, tracking what arrived, what is pending, and what to reorder gets messy fast.',
  },
  {
    icon: '📈',
    title: 'Price Drift',
    description: 'Prices change between cart and checkout, or from one drop to the next. Without history, you never know if a deal is actually good.',
  },
  {
    icon: '🗂️',
    title: 'Scattered Records',
    description: 'Order confirmations, tracking links, and wishlists live outside the place where you actually manage your Temu purchases.',
  },
]
---

<section class="py-16 sm:py-24 bg-card">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <h2
        class="animate-fade-up text-3xl sm:text-4xl font-bold text-foreground mb-4"
        style="font-family: var(--font-instrument-sans);"
      >
        Temu Shopping Is Split Across Too Many Surfaces
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-reveal>
      {problems.map((problem, index) => (
        <div
          class={`animate-fade-up delay-${(index + 1) * 100} group relative p-6 rounded-2xl bg-background border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300 ${
            problem.wide ? 'md:col-span-2' : ''
          }`}
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="text-3xl sm:text-4xl">{problem.icon}</span>
            <h3 class="text-xl sm:text-2xl font-semibold text-foreground">{problem.title}</h3>
          </div>
          <p class="text-base text-muted-foreground leading-relaxed">{problem.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
