---
const solutions = [
  {
    icon: '📁',
    title: 'Listes d’achat organisées',
    description: 'Regroupez vos trouvailles Temu par liste, session ou catégorie. Chaque produit reste identifié et facile à retrouver.',
  },
  {
    icon: '💾',
    title: 'Stockage hors ligne',
    description: 'Toutes vos données sont stockées en local sur votre appareil. Pas besoin d’internet pour consulter vos listes ni de créer un compte cloud.',
  },
  {
    icon: '🔍',
    title: 'Fiches produit détaillées',
    description: 'Conservez tout le contexte d’un produit : images, prix, notes et historique des observations au même endroit.',
  },
  {
    icon: '🔄',
    title: 'Synchronisez quand vous le souhaitez',
    description: 'La synchronisation premium reste facultative et activée à votre demande. Vous décidez quand et où vos données circulent.',
  },
]
---

<section class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <p class="animate-fade-up text-sm font-medium text-muted-foreground uppercase tracking-wider mb-2">Fonctionnement</p>
      <h2
        class="animate-fade-up delay-100 text-3xl sm:text-4xl font-bold text-foreground mb-4"
        style="font-family: var(--font-instrument-sans);"
      >
        Un seul outil pour vos listes Temu
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-reveal>
      {solutions.map((solution, index) => (
        <div
          class={`animate-fade-up delay-${(index + 1) * 100} group relative flex flex-col justify-between rounded-2xl bg-card border border-border hover:border-primary/30 hover:shadow-lg transition-all duration-300 overflow-hidden p-6 sm:p-8`}
        >
          <div>
            <h3 class="text-xl sm:text-2xl font-semibold text-foreground mb-3">{solution.title}</h3>
            <p class="text-base text-muted-foreground leading-relaxed">{solution.description}</p>
          </div>
          <div class="mt-6 flex items-center justify-end">
            <span class="text-4xl sm:text-5xl leading-none opacity-80 group-hover:scale-110 transition-transform duration-300">{solution.icon}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
