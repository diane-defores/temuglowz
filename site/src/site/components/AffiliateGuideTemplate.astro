---
import Footer from '../../components/Footer.astro'
import Layout from '../../layouts/Layout.astro'
import { buildGuideJsonLd } from '../lib/guideSchemas'
import ProductCard from './ProductCard.astro'
import ProductReviews from './ProductReviews.astro'

interface GuideProduct {
  rank: number
  name: string
  price: string
  image: string
  description: string
  rating?: number
  productUrl?: string
  pros?: string[]
  cons?: string[]
  bestFor?: string
  rationale?: string
  caution?: string
  priceNote?: string
  reviews?: Array<{ author: string; rating: number; text: string; date?: string }>
}

interface GuideData {
  title: string
  subtitle?: string
  description: string
  metaDescription?: string
  publishedDate?: string
  updatedDate: string
  selectionMethod?: string
  selectionCriteria?: string[]
  disclosure?: string
  sections: Array<{ id: string; title: string; products: GuideProduct[] }>
  faq?: Array<{ question: string; answer: string }>
}

interface Props {
  data: GuideData
  path: string
  breadcrumb: string
}

const { data, path, breadcrumb } = Astro.props
const jsonLd = buildGuideJsonLd({ path, lang: 'fr', data })
const disclosure = data.disclosure ?? 'Certains liens peuvent devenir des liens affiliés après notre adhésion à un programme partenaire. Si cela arrive, TemuGlowz pourra recevoir une commission sans coût supplémentaire pour vous. Nos sélections restent indépendantes et ne reposent pas sur des tests en main propres sauf mention contraire.'
---

<Layout title={`${data.title} | Guides d’achat TemuGlowz`} description={data.metaDescription ?? data.description} path={path} lang="fr-FR" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <article class="max-w-3xl mx-auto px-8 sm:px-10 pt-24 pb-12 xl:pr-80">
      <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-6" aria-label="Fil d’Ariane">
        <a href="/" class="hover:text-foreground transition-colors">Accueil</a><span aria-hidden="true">›</span><a href="/guides" class="hover:text-foreground transition-colors">Guides</a><span aria-hidden="true">›</span><span class="text-foreground">{breadcrumb}</span>
      </nav>
      <header class="mb-8" data-reveal>
        <div class="flex flex-wrap items-center gap-3 mb-4"><span class="inline-flex items-center px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold">Guide de sélection</span><time datetime={data.updatedDate} class="text-xs text-muted-foreground">Mis à jour le {data.updatedDate}</time></div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4" style="font-family: var(--font-cal-sans);">{data.title}</h1>
        {data.subtitle && <p class="text-lg text-muted-foreground mb-4">{data.subtitle}</p>}
        <p class="text-lg text-muted-foreground leading-relaxed">{data.description}</p>
      </header>
      <aside class="mb-8 rounded-2xl border border-primary/20 bg-primary/5 p-5 text-sm leading-relaxed text-muted-foreground" aria-label="Transparence sur les liens"><p><span class="font-semibold text-foreground">Transparence :</span> {disclosure}</p></aside>
      {(data.selectionMethod || data.selectionCriteria?.length) && <section class="mb-12 rounded-2xl border border-border bg-card/70 p-6" aria-labelledby="methodologie"><h2 id="methodologie" class="text-xl font-bold text-foreground mb-3">Comment nous construisons cette sélection</h2>{data.selectionMethod && <p class="text-muted-foreground leading-relaxed">{data.selectionMethod}</p>}{data.selectionCriteria?.length && <ul class="mt-4 grid gap-2 text-sm text-muted-foreground sm:grid-cols-2">{data.selectionCriteria.map((criterion) => <li class="rounded-lg bg-background/60 px-3 py-2">{criterion}</li>)}</ul>}</section>}
      {data.sections.map((section, sectionIndex) => <section id={section.id} class="mb-16 scroll-mt-24" aria-labelledby={`${section.id}-title`}><h2 id={`${section.id}-title`} class="text-2xl font-bold text-foreground mb-2 pb-2 border-b border-border">{section.title}</h2><p class="text-muted-foreground mb-6">Une sélection à comparer selon vos besoins : vérifiez toujours les caractéristiques et la disponibilité de la fiche Temu.</p><div class="space-y-4 sm:space-y-6">
  {section.products.map((product, productIndex) => (
    <div>
      <ProductCard {...product} highlighted={sectionIndex === 0 && productIndex === 0} />
      {product.reviews?.length ? <ProductReviews reviews={product.reviews} rank={product.rank} /> : null}
    </div>
  ))}
</div></section>)}
      {data.faq?.length && <section id="faq" class="mb-16 scroll-mt-24" data-reveal><h2 class="text-2xl font-bold text-foreground mb-6 pb-2 border-b border-border">Questions fréquentes</h2><div class="space-y-4">{data.faq.map((item) => <details class="group p-4 rounded-xl bg-card border border-border"><summary class="cursor-pointer font-semibold text-foreground list-none flex items-center justify-between">{item.question}<svg class="w-5 h-5 text-muted-foreground group-open:rotate-180 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><p class="mt-3 text-sm text-muted-foreground leading-relaxed">{item.answer}</p></details>)}</div></section>}
      <aside class="p-8 rounded-2xl bg-gradient-to-br from-primary/5 to-transparent border border-primary/20 text-center" data-reveal><h2 class="text-xl font-bold text-foreground mb-3">Comparez avant d’acheter</h2><p class="text-muted-foreground mb-6">Les prix, options et disponibilités évoluent : consultez les informations les plus récentes sur Temu avant de finaliser votre choix.</p><a href="/guides" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-card text-foreground font-medium border border-border hover:bg-muted transition-colors">Tous les guides</a></aside>
    </article>
    <Footer />
  </main>
</Layout>
