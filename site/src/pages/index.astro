---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import DiscoveryThemes from '../components/DiscoveryThemes.astro'
import FeaturedGuides from '../components/FeaturedGuides.astro'
import SelectionMethod from '../components/SelectionMethod.astro'
import FinalCTA from '../components/FinalCTA.astro'
import Footer from '../components/Footer.astro'
import { guideIndex } from '../site/data/guideIndex'

const title = 'ShopGlowz — Des gadgets utiles, malins et surprenants à découvrir'
const description = 'Découvrez des gadgets pratiques, mignons ou complètement inattendus pour la cuisine, la maison, les cadeaux, les vacances et le quotidien, avec plusieurs enseignes à comparer.'

const homepageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: 'https://temuglowz.com/',
    description,
    isPartOf: {
      '@type': 'WebSite',
      name: 'ShopGlowz',
      url: 'https://temuglowz.com/',
    },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: guideIndex.map((guide, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: guide.title,
        url: new URL(guide.slug, 'https://temuglowz.com/').toString(),
      })),
    },
  },
]
---

<Layout title={title} description={description} path="/" lang="fr-FR" jsonLd={homepageSchemas}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Hero />
    <DiscoveryThemes />
    <FeaturedGuides guides={guideIndex} />
    <SelectionMethod />
    <FinalCTA />
    <Footer />
  </main>
</Layout>
